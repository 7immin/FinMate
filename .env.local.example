# Copy this file to .env.local and fill in your project's values.

# Supabase -- Project Settings -> API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Gemini API key (free tier available) -- create one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# 은행 담당자 창구 화면(/bank)에만 필요합니다. 없으면 그 화면이
# "설정되지 않았습니다"라고 밝히고, 학생 앱은 그대로 동작합니다.
#
# SUPABASE_SERVICE_ROLE_KEY: Supabase Project Settings > API의 service_role 키.
#   담당자에게는 이 앱의 계정이 없어 RLS로는 남의 요청을 읽을 수 없으므로
#   이 경로만 RLS를 우회합니다. 절대 클라이언트로 나가면 안 되는 키입니다.
# BANK_ACCESS_CODE: 지점에 배포할 접근 코드. 아무 문자열이나 정하면 됩니다.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
BANK_ACCESS_CODE=your-branch-access-code
